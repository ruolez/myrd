<?xml version="1.0" encoding="UTF-8"?>
<!--
  RemoteAgent MSI (WiX v5). Per-machine, x64. Installs remote-agent.exe as the
  LocalSystem service "RemoteAgent" (`remote-agent.exe service`), which spawns
  `remote-agent.exe helper` into the active console session.

  Build (see build.ps1):
    wix build RemoteAgent.wxs -arch x64 -ext WixToolset.Util.wixext -ext WixToolset.UI.wixext
      -d Version=1.2.3 -d BinDir=..\..\agent\dist\windows [-d ServerUrl=https://remote.example.com] -o RemoteAgent.msi

  Interactive install (double-click): the "Add this PC" page asks for the server
  (pre-filled from ServerUrl) and the enrollment token.
  Scripted install (no UI):
    msiexec /i RemoteAgent.msi ENROLL_TOKEN=XXXX-XXXX SERVER_URL=https://remote.example.com /qn
  Install link (docs/PROTOCOL.md §2 "Install links"): the server names the MSI it hands out
  RemoteAgent-x.y.z-x64.link-XXXX-XXXX-XXXX.msi. Such a file skips the
  "Add this PC" page, and the service enrolls with the code in that name
  (registry InstallSource = [OriginalDatabase]).

  -d Win7=yes builds the Windows 7 installer around the Windows 7 exe
  (packaging/windows/win7) without WiX's custom-action DLL: the service sets
  its own restart policy when it starts (Windows Installer on Windows 7 fails
  the install with error 1939 on MsiServiceConfigFailureActions), and the
  data dir is not removed on uninstall (`remote-agent uninstall` still clears
  the device's identity).
  The normal installer refuses Windows 7.

  The product name is still an open decision (docs plan); everything that
  depends on it is a define below. UpgradeCode must never change once shipped.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef ProductName ?><?define ProductName = "RemoteAgent" ?><?endif?>
  <?ifndef Manufacturer ?><?define Manufacturer = "remotectl" ?><?endif?>
  <?ifndef UpgradeCode ?><?define UpgradeCode = "6B1E9D2A-3C4F-4E8B-9A70-5D2C8F1B7E43" ?><?endif?>
  <?ifndef Version ?><?define Version = "0.0.1" ?><?endif?>
  <?ifndef BinDir ?><?define BinDir = "..\..\agent\dist\windows" ?><?endif?>
  <?ifndef IncludeNativeDll ?><?define IncludeNativeDll = "no" ?><?endif?>
  <?ifndef Win7 ?><?define Win7 = "no" ?><?endif?>
  <?define ServiceName = "RemoteAgent" ?>
  <?define RegKey = "SOFTWARE\RemoteAgent" ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="$(UpgradeCode)"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <!-- Any installed version is replaced: same-version (dev builds share a version) and older
         ones, plus downgrades so the agent can reinstall its previous build after a failed update
         (the server never offers one). WiX rejects AllowSameVersionUpgrades next to AllowDowngrades;
         the latter already covers the same version.
         afterInstallExecute: the new version is installed before the old one is removed, so the
         components both share (same GUIDs) stay installed. The old package's uninstall therefore
         never removes the data dir (config, device key): packages up to 0.3.1 delete it on any
         uninstall, upgrades included. REINSTALLMODE "a" overwrites the unversioned exe. -->
    <MajorUpgrade Schedule="afterInstallExecute" AllowDowngrades="yes" />
    <?if $(Win7) = "yes" ?>
    <Launch Condition="Installed OR VersionNT &gt; 601 OR (VersionNT = 601 AND ServicePackLevel &gt;= 1)"
            Message="$(ProductName) needs Windows 7 Service Pack 1 or later." />
    <?else?>
    <Launch Condition="Installed OR VersionNT &gt;= 602"
            Message="This installer needs Windows 8 or later. On Windows 7, download the Windows 7 installer from the Add device page." />
    <?endif?>
    <Property Id="REINSTALLMODE" Value="amus" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Hidden keeps the one-time token out of verbose MSI logs. -->
    <Property Id="ENROLL_TOKEN" Secure="yes" Hidden="yes" />
    <?ifdef ServerUrl ?>
    <Property Id="SERVER_URL" Value="$(ServerUrl)" Secure="yes" />
    <?else?>
    <Property Id="SERVER_URL" Secure="yes" />
    <?endif?>
    <!-- Must be set before util's RemoveFoldersEx action, which runs just before CostInitialize.
         Only on a real uninstall: an upgrade must keep the device's identity. -->
    <SetProperty Id="DATADIR" Value="[CommonAppDataFolder]RemoteAgent" After="AppSearch" Sequence="both"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(ProductName)">

        <Component Id="AgentService" Bitness="always64">
          <File Id="AgentExe" Source="$(BinDir)\remote-agent.exe" KeyPath="yes" />
          <ServiceInstall Id="AgentServiceInstall"
                          Name="$(ServiceName)"
                          DisplayName="$(ProductName)"
                          Description="Remote control agent: keeps this device reachable for its owner and shows a visible indicator during sessions."
                          Type="ownProcess"
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal"
                          Arguments="service"
                          Vital="yes">
            <?if $(Win7) != "yes" ?>
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="5"
                                ResetPeriodInDays="1" />
            <?endif?>
          </ServiceInstall>
          <ServiceControl Id="AgentServiceControl"
                          Name="$(ServiceName)"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <?if $(IncludeNativeDll) = "yes" ?>
        <!-- MSVC build variant (-tags rcnative_msvc): the WGC-capable backend DLL. -->
        <Component Id="NativeDll" Bitness="always64">
          <File Id="RcNativeDll" Source="$(BinDir)\rcnative.dll" KeyPath="yes" />
        </Component>
        <?endif?>

        <!-- Data dir (%ProgramData%\RemoteAgent: config, DPAPI key blob, pins, logs) is removed on uninstall. -->
        <Component Id="DataDirCleanup" Guid="3E7A51C4-8B2D-4F6A-9C15-7D0E2B4A6F91" Bitness="always64">
          <RegistryValue Root="HKLM" Key="$(RegKey)" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <?if $(Win7) != "yes" ?>
          <util:RemoveFolderEx On="uninstall" Property="DATADIR" />
          <?endif?>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- One-time enrollment token: the service reads it, enrolls, then deletes the value. -->
    <Component Id="EnrollTokenValue" Directory="INSTALLFOLDER" Guid="9C4D2E7B-1A5F-4B83-8E60-2F7A9D3C5B18"
               Condition="ENROLL_TOKEN" Bitness="always64" Transitive="yes">
      <RegistryValue Root="HKLM" Key="$(RegKey)" Name="EnrollToken" Type="string" Value="[ENROLL_TOKEN]" KeyPath="yes" />
    </Component>
    <Component Id="ServerUrlValue" Directory="INSTALLFOLDER" Guid="5A8F3B1D-7E2C-4D96-A1B4-6C9E0F2D8A37"
               Condition="SERVER_URL" Bitness="always64">
      <RegistryValue Root="HKLM" Key="$(RegKey)" Name="ServerURL" Type="string" Value="[SERVER_URL]" KeyPath="yes" />
    </Component>
    <!-- Where the MSI was opened from: an install link's code is in its file name. -->
    <Component Id="InstallSourceValue" Directory="INSTALLFOLDER" Guid="995EB470-ABF2-449B-8062-ACD925A61CCB" Bitness="always64">
      <RegistryValue Root="HKLM" Key="$(RegKey)" Name="InstallSource" Type="string" Value="[OriginalDatabase]" KeyPath="yes" />
    </Component>
    <Component Id="RegKeyCleanup" Directory="INSTALLFOLDER" Guid="B2E6C9A4-0D3F-4A71-8B5E-1F4C7A9D2E60" Bitness="always64">
      <RegistryKey Root="HKLM" Key="$(RegKey)" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="Product" Type="string" Value="$(ProductName)" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <!-- On full uninstall (not upgrade) tell the server the device is removed, not offline. -->
    <CustomAction Id="AgentSelfRemove" FileRef="AgentExe" ExeCommand="uninstall"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="AgentSelfRemove" Before="StopServices"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <UIRef Id="RemoteAgentUI" />

    <Feature Id="Main" Title="$(ProductName)" Level="1">
      <ComponentRef Id="AgentService" />
      <?if $(IncludeNativeDll) = "yes" ?>
      <ComponentRef Id="NativeDll" />
      <?endif?>
      <ComponentRef Id="DataDirCleanup" />
      <ComponentRef Id="EnrollTokenValue" />
      <ComponentRef Id="ServerUrlValue" />
      <ComponentRef Id="InstallSourceValue" />
      <ComponentRef Id="RegKeyCleanup" />
    </Feature>
  </Package>

  <!--
    Minimal UI: one "Add this PC" page, then progress and finish. The service
    reads SERVER_URL/ENROLL_TOKEN from the registry and enrolls within seconds.
    Skipped by /qn, so scripted installs are unchanged.
  -->
  <Fragment>
    <UI Id="RemoteAgentUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="CancelDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Dialog Id="EnrollDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Add this PC to your devices" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Use the token shown in the web app under Devices, Add device, Windows." />

        <Control Id="ServerLabel" Type="Text" X="20" Y="60" Width="330" Height="12" Text="&amp;Server address:" />
        <Control Id="ServerEdit" Type="Edit" X="20" Y="74" Width="330" Height="18" Property="SERVER_URL" Text="{255}" />
        <Control Id="TokenLabel" Type="Text" X="20" Y="104" Width="330" Height="12" Text="&amp;Enrollment token (XXXX-XXXX):" />
        <Control Id="TokenEdit" Type="Edit" X="20" Y="118" Width="110" Height="18" Property="ENROLL_TOKEN" Text="{9}" />
        <Control Id="Hint" Type="Text" X="20" Y="148" Width="330" Height="50" NoPrefix="yes"
                 Text="The token is valid for 15 minutes. The PC appears in your device list a few seconds after setup finishes. Leave the token empty to install now and enroll later." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 ElevationShield="yes" Text="&amp;Install">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <InstallUISequence>
        <!-- ~>< is a case-insensitive "contains": an install link's MSI asks nothing. -->
        <Show Dialog="EnrollDlg" Before="ProgressDlg" Condition="NOT Installed AND NOT (OriginalDatabase ~&gt;&lt; &quot;.link-&quot;)" />
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
