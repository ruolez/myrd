<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime only. No App Sandbox: ScreenCaptureKit for a whole display
     and CGEvent injection are not available to sandboxed apps. -->
<plist version="1.0">
<dict>
	<!-- Terminal takeover reads Terminal.app / iTerm2 tabs over Apple Events and
	     asks for the Automation permission itself (AEDeterminePermissionToAutomateTarget). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
