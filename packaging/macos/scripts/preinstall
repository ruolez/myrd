#!/bin/sh
# Upgrade: stop the running agent of the console user before files change.
# Never touches the update daemon: it may be the one running this install.
LABEL="@BUNDLE_ID@"
APP="/Applications/@APP_NAME@.app"
TCC_MARK="/private/var/tmp/remotectl-tcc-reset"

# Remember whether the build being replaced is ad-hoc signed: its grants do
# not carry over to the new signature, so postinstall clears them. The file is
# created exclusively (noclobber) so a planted symlink is not followed.
rm -f "$TCC_MARK"
if [ -d "$APP" ] && codesign -dv "$APP" 2>&1 | grep -q '^Signature=adhoc'; then
  (set -C; : > "$TCC_MARK") 2>/dev/null || true
fi

user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != "root" ]; then
  uid=$(id -u "$user")
  launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
fi
exit 0
