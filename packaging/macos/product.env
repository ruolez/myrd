# Naming is an open decision (bundle id, Keychain service, LaunchAgent label are
# costly to change after release). Change it here only; the Go side mirrors
# BUNDLE_ID in identity.KeychainService and tray.ProductName.
PRODUCT_NAME=remotectl
APP_NAME=RemoteAgent
BUNDLE_ID=com.remotectl.agent
EXECUTABLE=remote-agent
MIN_MACOS=13.0
